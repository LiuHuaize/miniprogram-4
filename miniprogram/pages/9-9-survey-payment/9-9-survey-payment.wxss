page {
  height: 100vh;
  background: #f4f7fa;
  color: #34495e;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.page {
  height: 100vh;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

.status-spacer {
  height: 44px;
}

.nav-bar {
  padding: 8px 16px 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 14px;
  color: #64748b;
}

.nav-left,
.nav-right {
  display: flex;
  align-items: center;
  min-width: 60px;
}

.nav-left {
  color: #475569;
}

.nav-icon-wrap {
  width: 30px;
  height: 30px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.14);
  box-shadow: 0 3px 10px rgba(148, 163, 184, 0.08);
  margin-right: 8px;
}

.nav-text {
  font-size: 16px;
  font-weight: 500;
}

.nav-title {
  font-size: 17px;
  font-weight: 600;
  color: #2c3e50;
}

.nav-right {
  justify-content: flex-end;
}

.content {
  flex: 1;
  min-height: 0;
  padding: 12px 16px 120px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 0;
  overflow: hidden;
}

.card {
  background: #ffffff;
  border: none;
  border-radius: 16px;
  box-shadow: 0 8px 24px rgba(44, 62, 80, 0.04);
}

.intro-card {
  padding: 24px 20px;
  margin-bottom: 24px;
}

.intro-eyebrow {
  display: inline-flex;
  align-items: center;
  padding: 4px 10px;
  border-radius: 4px;
  background: rgba(108, 141, 159, 0.1);
  color: #6c8d9f;
  font-size: 12px;
  font-weight: 600;
}

.intro-title-group {
  margin-top: 14px;
}

.intro-title {
  display: block;
  font-size: 23px;
  line-height: 1.4;
  font-weight: 600;
  color: #2c3e50;
  letter-spacing: 0.5px;
}

.intro-title-sub {
  margin-top: 0;
}

.intro-desc {
  display: block;
  margin-top: 12px;
  font-size: 13px;
  line-height: 1.6;
  color: #8a9cae;
}

.intro-tags {
  margin-top: 20px;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.intro-tag {
  padding: 5px 14px;
  border-radius: 999px;
  background: #f4f7fa;
  color: #8a9cae;
  font-size: 12px;
  border: none;
}

.section {
  margin-top: 0;
}

.section-title {
  font-size: 16px;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 16px;
  padding-left: 4px;
}

.benefit-list {
  padding: 8px 20px;
}

.benefit-item {
  display: flex;
  gap: 12px;
  padding: 20px 0;
  border-bottom: 1px solid #ebeff3;
}

.benefit-item:last-child {
  border-bottom: none;
}

.benefit-mark {
  width: 6px;
  height: 6px;
  border-radius: 999px;
  background: #6c8d9f;
  opacity: 0.8;
  margin-top: 8px;
  flex-shrink: 0;
}

.benefit-main {
  flex: 1;
  min-width: 0;
}

.benefit-title {
  display: block;
  font-size: 15px;
  line-height: 1.5;
  font-weight: 600;
  color: #2c3e50;
}

.benefit-desc {
  display: block;
  margin-top: 6px;
  font-size: 13px;
  line-height: 1.5;
  color: #8a9cae;
}

.bottom-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 20px calc(12px + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: none;
  box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.03);
  z-index: 10;
}

.bottom-left {
  display: flex;
  flex-direction: column;
  gap: 0;
  min-width: 0;
  flex: 1;
}

.bottom-label {
  font-size: 12px;
  color: #8a9cae;
  display: block;
  margin-bottom: -2px;
}

.bottom-price {
  margin-top: 4px;
  display: flex;
  align-items: baseline;
  color: #2c3e50;
}

.price-currency {
  font-size: 16px;
  font-weight: 700;
  line-height: 1;
}

.price-number {
  margin-left: 2px;
  font-size: 26px;
  font-weight: 700;
  line-height: 1;
}

.bottom-note {
  margin-top: 2px;
  font-size: 11px;
  color: #8a9cae;
  line-height: 1.3;
  display: block;
}

.submit-btn {
  --td-button-primary-bg-color: #6c8d9f;
  --td-button-primary-border-color: #6c8d9f;
  --td-button-primary-hover-bg-color: #5e7e8f;
  --td-button-primary-hover-border-color: #5e7e8f;
  min-width: 154px;
  height: 48px;
  padding: 0 36px;
  font-size: 16px;
  font-weight: 600;
  border-radius: 999px;
  box-shadow: 0 4px 12px rgba(108, 141, 159, 0.2);
}
