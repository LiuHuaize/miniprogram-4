<view class="page">
  <view class="status-spacer"></view>

  <view class="nav-bar">
    <view class="nav-left" bindtap="onBack">
      <view class="nav-icon-wrap">
        <t-icon name="chevron-left" size="32rpx" />
      </view>
      <text class="nav-text">返回</text>
    </view>
    <text class="nav-title">常用信息</text>
    <view class="nav-right"></view>
  </view>

  <scroll-view class="scroll-area" scroll-y show-scrollbar="{{false}}">
    <view class="add-row" bindtap="onAdd">
      <view class="add-left">
        <view class="add-icon">
          <t-icon name="add" size="26rpx" />
        </view>
        <view class="add-copy">
          <text class="add-text">新增报名人信息</text>
          <text class="add-sub">创建新的常用营员档案</text>
        </view>
      </view>
      <t-icon name="chevron-right" size="26rpx" />
    </view>

    <view
      class="card camper-item {{item.disabled ? 'disabled' : ''}} {{selectedId === item.id && !item.disabled ? 'active' : ''}}"
      wx:for="{{campers}}"
      wx:key="id"
      data-id="{{item.id}}"
      data-disabled="{{item.disabled}}"
      bindtap="onSelect"
    >
      <view class="radio">
        <view class="radio-dot" wx:if="{{selectedId === item.id}}"></view>
      </view>
      <view class="camper-main">
        <view class="camper-head">
          <text class="camper-name">{{item.name}}</text>
          <text class="camper-lock" wx:if="{{item.disabled}}">已在其他营员中选择</text>
          <text class="camper-selected" wx:if="{{selectedId === item.id && !item.disabled}}">当前选择</text>
        </view>
        <text class="camper-sub">身份证明：{{item.idNoMask || '未填写'}}　身高：{{item.height || '未填写'}}　体重：{{item.weight || '未填写'}}</text>
      </view>
      <t-icon class="camper-arrow" name="chevron-right" size="26rpx" />
    </view>

    <view class="empty" wx:if="{{!campers.length}}">
      <text>暂无常用信息，请先新增</text>
    </view>
  </scroll-view>

  <view class="bottom-bar">
    <view class="confirm-btn" bindtap="onConfirm">
      <text class="confirm-btn-text">确认</text>
    </view>
  </view>

</view>
