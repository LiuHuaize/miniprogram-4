page {
  height: 100vh;
  background: linear-gradient(180deg, #f6f8fc 0%, #edf3f8 54%, #eaf0f6 100%);
  color: #1f2a37;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
}

.status-spacer {
  height: 44px;
}

.nav-bar {
  padding: 6px 16px 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 14px;
  color: #64748b;
}

.nav-left,
.nav-right {
  display: flex;
  align-items: center;
  min-width: 60px;
}

.nav-left {
  color: #475569;
}

.nav-icon-wrap {
  width: 28px;
  height: 28px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f6f9;
  border: 1px solid rgba(148, 163, 184, 0.2);
  margin-right: 6px;
}

.nav-text {
  font-weight: 500;
}

.nav-title {
  font-size: 16px;
  font-weight: 600;
  color: #0f172a;
}

.scroll-area {
  flex: 1;
  min-height: 0;
  padding: 0 16px;
  padding-bottom: calc(120px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.add-row {
  margin-top: 12px;
  background: linear-gradient(180deg, #ffffff 0%, #f9fbff 100%);
  border-radius: 18px;
  padding: 14px 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1px solid rgba(148, 163, 184, 0.14);
  box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08);
}

.add-left {
  display: flex;
  align-items: center;
  gap: 10px;
}

.add-icon {
  width: 30px;
  height: 30px;
  border-radius: 10px;
  background: rgba(77, 137, 186, 0.12);
  color: #4d89ba;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-copy {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.add-text {
  font-size: 14px;
  font-weight: 600;
  color: #0f172a;
}

.add-sub {
  font-size: 11px;
  color: #8ea0b4;
}

.card {
  background: linear-gradient(180deg, #ffffff 0%, #f9fbff 100%);
  border: 1px solid rgba(148, 163, 184, 0.14);
  border-radius: 18px;
  box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08);
  margin-top: 14px;
}

.camper-item {
  padding: 16px;
  display: flex;
  align-items: center;
  gap: 12px;
}

.camper-item.active {
  border-color: rgba(77, 137, 186, 0.28);
  background: linear-gradient(180deg, rgba(77, 137, 186, 0.08) 0%, rgba(77, 137, 186, 0.03) 100%);
}

.camper-item.disabled {
  border-color: rgba(148, 163, 184, 0.18);
  background: #f8fafc;
  box-shadow: none;
}

.radio {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  border: 2px solid #cbd5e1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.camper-item.active .radio {
  border-color: #4d89ba;
}

.camper-item.disabled .radio {
  border-color: #dbe3ec;
}

.radio-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #4d89ba;
}

.camper-main {
  flex: 1;
  min-width: 0;
}

.camper-head {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.camper-name {
  font-size: 14px;
  font-weight: 700;
  color: #0f172a;
  display: block;
}

.camper-lock {
  font-size: 10px;
  color: #9a6b1f;
  padding: 4px 8px;
  border-radius: 999px;
  background: rgba(245, 158, 11, 0.08);
  display: block;
}

.camper-selected {
  font-size: 10px;
  color: #3f6c91;
  padding: 4px 8px;
  border-radius: 999px;
  background: rgba(77, 137, 186, 0.1);
  display: block;
}

.camper-sub {
  margin-top: 4px;
  font-size: 11px;
  color: #7d8da1;
  display: block;
  line-height: 1.5;
}

.camper-arrow {
  color: #9cabba;
  flex-shrink: 0;
}

.camper-item.disabled .camper-name,
.camper-item.disabled .camper-sub {
  color: #94a3b8;
}

.empty {
  margin-top: 16px;
  text-align: center;
  color: #94a3b8;
  font-size: 12px;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
  border-top: none;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -4px 16px rgba(15, 23, 42, 0.05);
  backdrop-filter: blur(16px);
  display: flex;
  justify-content: center;
}

.confirm-btn {
  width: 100%;
  height: 46px;
  border-radius: 999px;
  background: linear-gradient(135deg, #76b6e1 0%, #4d89ba 52%, #3c73a2 100%);
  box-shadow: 0 12px 24px rgba(77, 137, 186, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
}

.confirm-btn-text {
  color: #ffffff;
  font-size: 15px;
  font-weight: 700;
}
