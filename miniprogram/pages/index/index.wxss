page {
  height: 100vh;
  background: #ffffff;
  color: #1f2a37;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
}

.status-spacer {
  height: 44px;
}

.page-title {
  padding: 16px 0 16px;
  text-align: center;
  font-size: 17px;
  font-weight: 600;
  color: #0f172a;
}

.filter-row {
  display: flex;
  align-items: center;
  padding: 4px 16px 14px;
  font-size: 14px;
  font-weight: 500;
  color: #4b5563;
}

.filter-item {
  margin-right: 36px;
  display: flex;
  align-items: center;
}

.filter-item--active {
  color: #111827;
  font-weight: 600;
}

.filter-icon {
  margin-left: 2px;
}

.search-section {
  padding: 6px 16px 16px;
}

.search {
  --td-search-height: 72rpx;
  --td-search-padding: 12rpx 24rpx;
  --td-search-bg-color: #f9fafb;
  --td-search-placeholder-color: #9ca3af;
  --td-search-icon-color: #9ca3af;
  --td-search-text-color: #111827;
  --td-search-square-radius: 999px;
  border-radius: 999px;
}

.scroll-area {
  flex: 1;
  min-height: 0;
  padding: 0 16px;
  padding-bottom: calc(140px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.card-list {
  padding-bottom: 20px;
}

.card {
  background: #ffffff;
  border-radius: 0;
  overflow: hidden;
  margin-bottom: 28px;
}

.card:last-child {
  margin-bottom: 0;
}

.card-hero {
  position: relative;
  width: 100%;
  line-height: 0;
  display: flex;
  flex-direction: column;
}

.card-hero-bg {
  width: 100%;
  height: auto;
  display: block;
}

.card-hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.04), rgba(15, 23, 42, 0.38));
}

.card-hero-top {
  position: absolute;
  top: 12px;
  left: 12px;
  display: flex;
  align-items: center;
  z-index: 1;
}

.card-hero-sub {
  font-size: 11px;
  opacity: 0.9;
  margin-left: 8px;
}

.card-hero-bottom {
  position: absolute;
  bottom: 14px;
  left: 14px;
  display: flex;
  flex-direction: column;
  z-index: 1;
}

.card-hero-title {
  font-size: 17px;
  font-weight: 600;
  line-height: 1.35;
}

.card-hero-desc {
  font-size: 11px;
  opacity: 0.9;
  margin-top: 4px;
  line-height: 1.45;
}

.card-hero--light .card-hero-title,
.card-hero--light .card-hero-desc,
.card-hero--light .card-hero-sub {
  color: #ffffff;
}

.card-hero--dark .card-hero-title,
.card-hero--dark .card-hero-desc,
.card-hero--dark .card-hero-sub {
  color: #334155;
}

.card-hero--dark .card-hero-desc,
.card-hero--dark .card-hero-sub {
  opacity: 1;
  color: #475569;
}

.card-body {
  padding: 10px 0 0;
  display: flex;
  flex-direction: column;
}

.card-title {
  font-size: 16px;
  font-weight: 600;
  color: #111827;
  margin-bottom: 6px;
  line-height: 1.45;
}

.card-meta {
  font-size: 11.5px;
  color: #6b7280;
  line-height: 1.6;
}

.card-tag {
  font-size: 11px;
  line-height: 1;
  padding: 8rpx 12rpx;
  border-radius: 2rpx;
  font-weight: 500;
  letter-spacing: 0.2px;
}

.card-tag--active {
  background: rgba(255, 255, 255, 0.95);
  color: #111827;
}

.card-tag--ended {
  background: rgba(255, 255, 255, 0.95);
  color: #94a3b8;
}

.bottom-bar {
  --td-tab-bar-active-color: #7ca0b0;
  --td-tab-bar-color: #9ca3af;
  --td-tab-bar-border-color: #e2e8f0;
  --td-tab-bar-height: 96rpx;
  --td-font-body-extraSmall: 22rpx;
  background-color: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(10px);
}

.tab-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-indicator {
  position: fixed;
  bottom: 8px;
  left: 50%;
  transform: translateX(-50%);
  width: 120px;
  height: 4px;
  border-radius: 999px;
  background: #0f172a;
  opacity: 0.12;
  pointer-events: none;
  z-index: 6;
}
