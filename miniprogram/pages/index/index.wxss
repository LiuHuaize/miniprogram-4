page {
  height: 100vh;
  background: #ffffff;
  color: #1f2a37;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.page {
  height: 100vh;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  box-sizing: border-box;
}

.status-spacer {
  height: 44px;
}

.page-title {
  padding: 16px 0 16px;
  text-align: center;
  font-size: 17px;
  font-weight: 600;
  color: #0f172a;
}

.filter-row {
  display: flex;
  align-items: center;
  padding: 4px 14px 14px;
  font-size: 14px;
  font-weight: 500;
  color: #4b5563;
}

.filter-item {
  margin-right: 36px;
  display: flex;
  align-items: center;
}

.filter-item--active {
  color: #111827;
  font-weight: 600;
}

.filter-icon {
  margin-left: 2px;
}

.search-section {
  padding: 6px 14px 16px;
}

.search {
  --td-search-height: 72rpx;
  --td-search-padding: 12rpx 24rpx;
  --td-search-bg-color: #f9fafb;
  --td-search-placeholder-color: #9ca3af;
  --td-search-icon-color: #9ca3af;
  --td-search-text-color: #111827;
  --td-search-square-radius: 999px;
  border-radius: 999px;
}

.scroll-area {
  flex: 1;
  min-height: 0;
  margin-bottom: calc(96rpx + env(safe-area-inset-bottom) + 28px);
  padding: 0 14px;
  box-sizing: border-box;
}

.card-list {
  padding-bottom: 24px;
}

.card {
  background: #ffffff;
  border-radius: 0;
  overflow: hidden;
  margin-bottom: 32px;
}

.card:last-child {
  margin-bottom: 0;
}

.card-hero {
  position: relative;
  width: 100%;
  aspect-ratio: 1.4 / 1;
  background-color: #f3f4f6;
  animation: skeleton-loading 1.4s ease-in-out infinite;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

@keyframes skeleton-loading {
  0% {
    background-color: #f3f4f6;
  }
  50% {
    background-color: #e5e7eb;
  }
  100% {
    background-color: #f3f4f6;
  }
}

.card-hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
  z-index: 0;
}

.card-hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.04), rgba(15, 23, 42, 0.38));
}

.card-hero-top {
  position: absolute;
  top: 12px;
  left: 12px;
  display: flex;
  align-items: center;
  z-index: 1;
}

.card-hero-sub {
  font-size: 12px;
  opacity: 0.9;
  margin-left: 8px;
}

.card-hero-bottom {
  position: absolute;
  bottom: 14px;
  left: 14px;
  display: flex;
  flex-direction: column;
  z-index: 1;
}

.card-hero-title {
  font-size: 18px;
  font-weight: 600;
  line-height: 1.35;
}

.card-hero-desc {
  font-size: 12px;
  opacity: 0.9;
  margin-top: 4px;
  line-height: 1.45;
}

.card-hero--light .card-hero-title,
.card-hero--light .card-hero-desc,
.card-hero--light .card-hero-sub {
  color: #ffffff;
}

.card-hero--dark .card-hero-title,
.card-hero--dark .card-hero-desc,
.card-hero--dark .card-hero-sub {
  color: #334155;
}

.card-hero--dark .card-hero-desc,
.card-hero--dark .card-hero-sub {
  opacity: 1;
  color: #475569;
}

.card-body {
  padding: 12px 0 0;
  display: flex;
  flex-direction: column;
}

.card-title {
  font-size: 17px;
  font-weight: 600;
  color: #111827;
  margin-bottom: 6px;
  line-height: 1.45;
}

.card-meta {
  font-size: 13px;
  color: #6b7280;
  line-height: 1.6;
}

.card-tag {
  font-size: 12px;
  line-height: 1;
  padding: 10rpx 14rpx;
  border-radius: 2rpx;
  font-weight: 500;
  letter-spacing: 0.2px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.card-tag--active {
  background: #ffffff;
  color: #111827;
  box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.08);
}

.card-tag--ended {
  background: #ffffff;
  color: #64748b;
  box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.08);
}

.bottom-bar-cover {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(96rpx + env(safe-area-inset-bottom));
  height: 28px;
  background: #ffffff;
  pointer-events: none;
  z-index: 9;
}

.bottom-bar {
  --td-tab-bar-active-color: #7ca0b0;
  --td-tab-bar-color: #9ca3af;
  --td-tab-bar-border-color: #e2e8f0;
  --td-tab-bar-height: 96rpx;
  --td-font-body-extraSmall: 22rpx;
  background-color: #ffffff;
  backdrop-filter: blur(10px);
  box-shadow: 0 -8px 24px rgba(15, 23, 42, 0.06);
  z-index: 10;
}

.tab-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}
