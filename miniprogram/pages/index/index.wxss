page {
  height: 100vh;
  background: #f8fafc;
  color: #1f2a37;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
}

.status-spacer {
  height: 44px;
}

.page-title {
  padding: 6px 0 14px;
  text-align: center;
  font-size: 17px;
  font-weight: 600;
  color: #0f172a;
}

.search-section {
  padding: 0 18px 14px;
}

.search {
  --td-search-height: 72rpx;
  --td-search-padding: 12rpx 24rpx;
  --td-search-bg-color: #f8fafc;
  --td-search-placeholder-color: #94a3b8;
  --td-search-icon-color: #94a3b8;
  --td-search-text-color: #0f172a;
  --td-search-square-radius: 32rpx;
  border-radius: 999px;
  border: 1px solid #e2e8f0;
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
}

.scroll-area {
  flex: 1;
  min-height: 0;
  padding: 0 18px;
  padding-bottom: calc(140px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.card-list {
  padding-bottom: 20px;
}

.card {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 6px 14px rgba(15, 23, 42, 0.05);
  margin-bottom: 20px;
}

.card:last-child {
  margin-bottom: 0;
}

.card-hero {
  position: relative;
  height: 168px;
}

.card-hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.04), rgba(15, 23, 42, 0.38));
}

.card-hero-top {
  position: absolute;
  top: 12px;
  left: 12px;
  display: flex;
  align-items: center;
  z-index: 1;
}

.card-hero-sub {
  font-size: 11px;
  opacity: 0.9;
  margin-left: 8px;
}

.card-hero-bottom {
  position: absolute;
  bottom: 14px;
  left: 14px;
  display: flex;
  flex-direction: column;
  z-index: 1;
}

.card-hero-title {
  font-size: 17px;
  font-weight: 600;
  line-height: 1.35;
}

.card-hero-desc {
  font-size: 11px;
  opacity: 0.9;
  margin-top: 4px;
  line-height: 1.45;
}

.card-hero--light .card-hero-title,
.card-hero--light .card-hero-desc,
.card-hero--light .card-hero-sub {
  color: #ffffff;
}

.card-hero--dark .card-hero-title,
.card-hero--dark .card-hero-desc,
.card-hero--dark .card-hero-sub {
  color: #334155;
}

.card-hero--dark .card-hero-desc,
.card-hero--dark .card-hero-sub {
  opacity: 1;
  color: #475569;
}

.card-body {
  padding: 18px 16px;
  display: flex;
  flex-direction: column;
}

.card-title {
  font-size: 15px;
  font-weight: 600;
  color: #0f172a;
  margin-bottom: 8px;
  line-height: 1.45;
}

.card-meta {
  font-size: 12px;
  color: #6b7280;
  line-height: 1.6;
}

.card-tag {
  font-size: 11px;
  line-height: 1;
  padding: 7rpx 14rpx;
  border-radius: 999px;
  font-weight: 600;
  letter-spacing: 0.2px;
}

.card-tag--active {
  background: rgba(236, 253, 243, 0.94);
  color: #15803d;
  border: 1px solid #bbf7d0;
}

.card-tag--ended {
  background: rgba(241, 245, 249, 0.96);
  color: #64748b;
  border: 1px solid #e2e8f0;
}

.bottom-bar {
  --td-tab-bar-active-color: #1f7a70;
  --td-tab-bar-color: #9ca3af;
  --td-tab-bar-border-color: #e2e8f0;
  --td-tab-bar-height: 96rpx;
  --td-font-body-extraSmall: 22rpx;
  background-color: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(10px);
}

.tab-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-indicator {
  position: fixed;
  bottom: 8px;
  left: 50%;
  transform: translateX(-50%);
  width: 120px;
  height: 4px;
  border-radius: 999px;
  background: #0f172a;
  opacity: 0.12;
  pointer-events: none;
  z-index: 6;
}
