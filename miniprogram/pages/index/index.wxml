<view class="page">
  <view class="status-spacer"></view>

  <view class="page-title">少年亿小步教育</view>

  <view class="filter-row">
    <view class="filter-item filter-item--active">综合排序</view>
    <view class="filter-item" bindtap="onTypeFilterTap">{{currentTypeFilter}} <t-icon name="chevron-down" size="32rpx" color="#9ca3af" class="filter-icon" /></view>
  </view>

  <view class="search-section">
    <t-search
      class="search"
      shape="round"
      placeholder="请输入活动名称"
      clearable="{{true}}"
      value="{{searchKeyword}}"
      bindchange="onSearchChange"
    />
  </view>

  <scroll-view class="scroll-area" scroll-y show-scrollbar="{{false}}">
    <view class="card-list">
      <block wx:for="{{cards}}" wx:key="id">
        <view class="card" bindtap="onCardTap" data-id="{{item.id}}" data-activity-id="{{item.activityId}}">
          <view class="card-hero {{item.themeClass}}">
            <image class="card-hero-bg" src="{{item.coverUrl}}" mode="aspectFill" lazy-load="true"></image>
            <view wx:if="{{item.overlayStyle}}" class="card-hero-overlay" style="{{item.overlayStyle}}"></view>
            <view class="card-hero-bottom">
              <text class="card-tag {{item.statusClass}}">{{item.status}}</text>
              <text wx:if="{{item.heroTitle}}" class="card-hero-title">{{item.heroTitle}}</text>
              <text wx:if="{{item.heroDesc}}" class="card-hero-desc">{{item.heroDesc}}</text>
            </view>
          </view>
          <view class="card-body">
            <text class="card-title">{{item.title}}</text>
            <text class="card-meta">{{item.meta}}</text>
          </view>
        </view>
      </block>
    </view>
  </scroll-view>

  <view class="bottom-bar-cover"></view>

  <t-tab-bar
    class="bottom-bar"
    value="{{tabValue}}"
    fixed="{{true}}"
    bordered="{{true}}"
    safe-area-inset-bottom="{{true}}"
    bindchange="onTabChange"
  >
    <t-tab-bar-item value="activity">
      <view slot="icon" class="tab-icon">
        <t-icon name="home" size="40rpx" />
      </view>
      活动
    </t-tab-bar-item>
    <t-tab-bar-item value="mine">
      <view slot="icon" class="tab-icon">
        <t-icon name="user-1" size="40rpx" />
      </view>
      我的
    </t-tab-bar-item>
  </t-tab-bar>

</view>
