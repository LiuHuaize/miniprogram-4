page {
  height: 100vh;
  background: #f5f7fb;
  color: #34495e;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.page {
  height: 100vh;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.status-spacer {
  height: 44px;
}

.nav-bar {
  padding: 6px 16px 8px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 14px;
  color: #64748b;
}

.nav-left,
.nav-right {
  display: flex;
  align-items: center;
  min-width: 76px;
}

.nav-left {
  color: #475569;
}

.nav-icon-wrap {
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 2px;
}

.nav-text {
  font-size: 15px;
  font-weight: 500;
}

.nav-title {
  font-size: 17px;
  font-weight: 600;
  color: #2c3e50;
}

.nav-right {
  justify-content: flex-end;
}

.scroll-area {
  flex: 1;
  min-height: 0;
  padding: 6px 0 10px;
  box-sizing: border-box;
}

.content-shell {
  padding: 0 16px;
}

.card {
  background: #ffffff;
  border-radius: 16px;
  box-shadow: 0 8px 24px rgba(44, 62, 80, 0.035);
}

.intro-card {
  padding: 20px 18px 18px;
}

.intro-title {
  display: block;
  font-size: 17px;
  line-height: 1.45;
  font-weight: 700;
  color: #31465d;
}

.intro-desc {
  display: block;
  margin-top: 8px;
  font-size: 13px;
  line-height: 1.6;
  color: #96a4b5;
}

.intro-rule-box {
  margin-top: 12px;
  padding: 11px 12px;
  border-radius: 12px;
  background: #f7f9fc;
}

.intro-rule-list {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
  white-space: nowrap;
}

.intro-rule-item {
  flex: 1;
  min-width: 0;
  font-size: 11px;
  line-height: 1.4;
  text-align: center;
  color: #8fa0b1;
}

.section {
  margin-top: 18px;
}

.section-last {
  padding-bottom: 0;
}

.section-title {
  margin-bottom: 12px;
  padding-left: 2px;
  font-size: 16px;
  font-weight: 700;
  color: #31465d;
}

.field-card {
  padding: 18px 16px 20px;
}

.field-label {
  font-size: 15px;
  line-height: 1.55;
  font-weight: 700;
  color: #31465d;
}

.field-textarea {
  width: 100%;
  min-height: 68px;
  margin-top: 12px;
  padding: 14px 16px;
  box-sizing: border-box;
  border-radius: 14px;
  background: #f4f7fa;
  border: 1px solid rgba(148, 163, 184, 0.1);
  color: #31465d;
  font-size: 14px;
  line-height: 1.6;
}

.field-placeholder {
  color: #a8b5c4;
}

.question-card {
  padding: 18px 16px 18px;
  margin-bottom: 12px;
}

.question-title-row {
  display: flex;
  align-items: flex-start;
  gap: 4px;
}

.question-index {
  flex-shrink: 0;
  font-size: 16px;
  line-height: 1.6;
  font-weight: 700;
  color: #31465d;
}

.question-title {
  flex: 1;
  font-size: 15px;
  line-height: 1.62;
  font-weight: 700;
  color: #31465d;
}

.score-row {
  margin-top: 16px;
  display: flex;
  gap: 10px;
}

.score-pill-wrap {
  flex: 1;
  min-width: 0;
}

.score-pill {
  width: 100%;
  height: 42px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f4f7fb;
  color: #4e6177;
  font-size: 14px;
  font-weight: 700;
  line-height: 1;
  transition: all 0.2s ease;
}

.score-pill--active {
  background: #6c8d9f;
  color: #ffffff;
  transform: scale(1.03);
  box-shadow: 0 6px 14px rgba(108, 141, 159, 0.26);
}

.scroll-bottom-spacer {
  height: 0;
}

.bottom-bar {
  padding: 0 12px calc(10px + env(safe-area-inset-bottom));
  background: transparent;
}

.bottom-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 12px 16px;
  background: rgba(255, 255, 255, 0.98);
  border-radius: 16px;
  box-shadow: 0 8px 24px rgba(44, 62, 80, 0.12);
}

.bottom-left {
  min-width: 0;
  flex: 1;
}

.bottom-count {
  display: flex;
  align-items: flex-end;
  gap: 6px;
  color: #31465d;
}

.bottom-count-label {
  font-size: 13px;
  font-weight: 600;
  line-height: 1.2;
}

.bottom-count-number {
  font-size: 16px;
  line-height: 1.05;
  font-weight: 700;
  letter-spacing: 0.2px;
}

.bottom-note {
  display: block;
  margin-top: 3px;
  font-size: 10px;
  line-height: 1.5;
  color: #8a9cae;
}

.submit-btn {
  width: 108px;
  height: 48px;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 999px;
  background: linear-gradient(135deg, #7a9cae 0%, #6b8799 100%);
  color: #ffffff;
  font-size: 15px;
  font-weight: 700;
  line-height: 48px;
  box-shadow: 0 6px 16px rgba(108, 141, 159, 0.2);
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  opacity: 0.72;
  color: rgba(255, 255, 255, 0.92);
}
