page {
  height: 100vh;
  background: linear-gradient(180deg, #f6f8fc 0%, #edf3f8 54%, #eaf0f6 100%);
  color: #1f2a37;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
}

.status-spacer {
  height: 44px;
}

.nav-bar {
  padding: 6px 16px 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 14px;
  color: #64748b;
}

.nav-left,
.nav-right {
  display: flex;
  align-items: center;
  min-width: 60px;
}

.nav-left {
  color: #475569;
}

.nav-icon-wrap {
  width: 28px;
  height: 28px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f6f9;
  border: 1px solid rgba(148, 163, 184, 0.2);
  margin-right: 6px;
}

.nav-text {
  font-weight: 500;
}

.nav-title {
  font-size: 16px;
  font-weight: 600;
  color: #0f172a;
}

.nav-right {
  justify-content: flex-end;
}

.scroll-area {
  flex: 1;
  min-height: 0;
  padding: 0 16px;
  padding-bottom: calc(140px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.card {
  background: linear-gradient(180deg, #ffffff 0%, #f9fbff 100%);
  border: 1px solid rgba(148, 163, 184, 0.14);
  border-radius: 18px;
  box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08);
  margin-bottom: 14px;
}

.summary-card {
  display: flex;
  gap: 12px;
  padding: 14px;
  align-items: center;
}

.summary-thumb {
  width: 80px;
  height: 64px;
  border-radius: 12px;
  background: linear-gradient(135deg, #0f172a 0%, #334155 55%, #64748b 100%);
}

.summary-main {
  flex: 1;
  min-width: 0;
}

.summary-kicker {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.16em;
  color: #8b9caf;
  display: block;
  margin-bottom: 6px;
}

.summary-title {
  font-size: 14px;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  display: block;
}

.summary-sub {
  margin-top: 4px;
  font-size: 11px;
  color: #7a8b9f;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  display: block;
}

.summary-price-line,
.bottom-price-line {
  display: flex;
  align-items: flex-start;
  gap: 2px;
}

.summary-price-unit,
.bottom-price-unit {
  font-size: 14px;
  font-weight: 700;
  color: #466f97;
  line-height: 1.2;
  padding-top: 4px;
}

.summary-price {
  font-size: 26px;
  font-weight: 700;
  color: #466f97;
  line-height: 0.92;
  letter-spacing: 0.01em;
  font-family: 'DIN Alternate', 'DIN Condensed', 'Avenir Next', sans-serif;
  flex-shrink: 0;
}

.info-card {
  padding: 14px 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  font-size: 13px;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.info-label {
  color: #9cabba;
}

.info-value {
  color: #1f2937;
  font-weight: 600;
}

.info-value--success,
.field-value--success {
  color: #10b981;
}

.section {
  margin-bottom: 14px;
}

.section-title {
  font-size: 13px;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 10px;
  padding-left: 4px;
}

.form-card {
  padding: 2px 14px;
}

.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 2px;
  font-size: 13px;
  border-bottom: 1px solid #edf0f3;
  gap: 16px;
}

.field-row--last {
  border-bottom: none;
}

.field-label {
  color: #1f2937;
  font-weight: 600;
  min-width: 88px;
}

.field-value {
  color: #0f172a;
  text-align: right;
  flex: 1;
}

.note-card {
  padding: 14px 16px;
  background: rgba(255, 255, 255, 0.72);
}

.note-text {
  font-size: 12px;
  color: #8ea0b4;
  line-height: 1.6;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
  border-top: none;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -4px 16px rgba(15, 23, 42, 0.05);
  backdrop-filter: blur(16px);
}

.bottom-left {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.bottom-label {
  font-size: 11px;
  color: #99a8b8;
}

.bottom-price {
  font-size: 28px;
  font-weight: 700;
  color: #21384f;
  line-height: 0.92;
  letter-spacing: 0.01em;
  font-family: 'DIN Alternate', 'DIN Condensed', 'Avenir Next', sans-serif;
}

.paid-btn {
  min-width: 120px;
  height: 46px;
  padding: 0 24px;
  border-radius: 999px;
  background: linear-gradient(135deg, #c3cfdb 0%, #98a6b5 100%);
  box-shadow: 0 10px 18px rgba(148, 163, 184, 0.22);
  color: #ffffff;
  font-size: 14px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
