<view class="page">
  <view class="status-spacer"></view>

  <view class="nav-bar">
    <view class="nav-left" bindtap="onBack">
      <view class="nav-icon-wrap">
        <t-icon name="chevron-left" size="32rpx" />
      </view>
      <text class="nav-text">返回</text>
    </view>
    <text class="nav-title">订单详情</text>
    <view class="nav-right"></view>
  </view>

  <scroll-view class="scroll-area" scroll-y show-scrollbar="{{false}}">
    <view class="card summary-card">
      <view class="summary-thumb"></view>
      <view class="summary-main">
        <text class="summary-kicker">ORDER SUMMARY</text>
        <text class="summary-title">{{summary.title || '--'}}</text>
        <text class="summary-sub">{{summary.sub || '--'}}</text>
      </view>
      <view class="summary-price-line">
        <text class="summary-price-unit">{{amountUnit}}</text>
        <text class="summary-price">{{amountValue}}</text>
      </view>
    </view>

    <view class="card info-card">
      <view class="info-row">
        <text class="info-label">支付状态</text>
        <text class="info-value {{statusClass}}">{{statusText}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">订单号</text>
        <text class="info-value">{{orderNo}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">下单时间</text>
        <text class="info-value">{{orderTimeText}}</text>
      </view>
    </view>

    <view class="section" wx:if="{{scholarshipCode || scholarshipDiscountAmount}}">
      <view class="section-title">优惠信息</view>
      <view class="card form-card">
        <view class="field-row" wx:if="{{scholarshipCode}}">
          <text class="field-label">兑换码</text>
          <text class="field-value">{{scholarshipCode}}</text>
        </view>
        <view class="field-row" wx:if="{{scholarshipDiscountAmount}}">
          <text class="field-label">奖学金抵扣</text>
          <text class="field-value field-value--success">{{scholarshipDiscountText}}</text>
        </view>
        <view class="field-row field-row--last" wx:if="{{scholarshipStatusText}}">
          <text class="field-label">兑换状态</text>
          <text class="field-value field-value--success">{{scholarshipStatusText}}</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">学员信息</view>
      <view class="card form-card" wx:for="{{campers}}" wx:key="id">
        <view class="field-row">
          <text class="field-label">学员姓名</text>
          <text class="field-value">{{item.name || '--'}}</text>
        </view>
        <view class="field-row">
          <text class="field-label">身份证明</text>
          <text class="field-value">{{item.idNo || '--'}}</text>
        </view>
        <view class="field-row">
          <text class="field-label">身高 / 体重</text>
          <text class="field-value">{{item.heightWeight || '--'}}</text>
        </view>
        <view class="field-row field-row--last">
          <text class="field-label">出行方式</text>
          <text class="field-value">{{travelText}}</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">监护人信息</view>
      <view class="card form-card">
        <view class="field-row">
          <text class="field-label">监护人姓名</text>
          <text class="field-value">{{guardian.name || '--'}}</text>
        </view>
        <view class="field-row">
          <text class="field-label">身份证明</text>
          <text class="field-value">{{guardian.idNo || '--'}}</text>
        </view>
        <view class="field-row field-row--last">
          <text class="field-label">联系电话</text>
          <text class="field-value">{{guardian.phone || '--'}}</text>
        </view>
      </view>
    </view>

    <view class="card note-card">
      <text class="note-text">如需修改信息，请联系老师或在订单列表中发起咨询。</text>
    </view>
  </scroll-view>

  <view class="bottom-bar">
    <view class="bottom-left">
      <text class="bottom-label">合计金额</text>
      <view class="bottom-price-line">
        <text class="bottom-price-unit">{{amountUnit}}</text>
        <text class="bottom-price">{{amountValue}}</text>
      </view>
    </view>
    <view class="paid-btn">{{statusText}}</view>
  </view>

</view>
