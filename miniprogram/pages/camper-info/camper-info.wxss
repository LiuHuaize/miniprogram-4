page {
  height: 100vh;
  background: linear-gradient(180deg, #f6f8fc 0%, #edf3f8 54%, #eaf0f6 100%);
  color: #1f2a37;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
}

.status-spacer {
  height: 44px;
}

.nav-bar {
  padding: 6px 16px 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 14px;
  color: #64748b;
}

.nav-left,
.nav-right {
  display: flex;
  align-items: center;
  min-width: 60px;
}

.nav-left {
  color: #475569;
}

.nav-icon-wrap {
  width: 28px;
  height: 28px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f6f9;
  border: 1px solid rgba(148, 163, 184, 0.2);
  margin-right: 6px;
}

.nav-text {
  font-weight: 500;
}

.nav-title {
  font-size: 16px;
  font-weight: 600;
  color: #0f172a;
}

.scroll-area {
  flex: 1;
  min-height: 0;
  padding: 0 16px;
  padding-bottom: calc(120px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.card {
  background: linear-gradient(180deg, #ffffff 0%, #f9fbff 100%);
  border: 1px solid rgba(148, 163, 184, 0.14);
  border-radius: 18px;
  box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08);
  margin-top: 14px;
}

.form-card {
  padding: 2px 14px;
}

.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 2px;
  font-size: 13px;
  border-bottom: 1px solid #edf0f3;
  gap: 16px;
}

.field-row--last {
  border-bottom: none;
}

.field-label {
  color: #1f2937;
  font-weight: 600;
  line-height: 1.4;
  min-width: 108px;
}

.field-value {
  flex: 1;
  min-width: 0;
  display: flex;
  justify-content: flex-end;
}

.field-row--stacked {
  flex-direction: column;
  align-items: stretch;
  gap: 10px;
  justify-content: flex-start;
}

.field-input {
  width: 100%;
  text-align: right;
  --td-input-vertical-padding: 6px;
  --td-input-bg-color: transparent;
  --td-input-placeholder-text-color: #a0aec0;
  --td-input-default-text-color: #1f2937;
}

.field-input--stacked {
  text-align: left;
}

.field-helper {
  margin: -4px 2px 2px;
  padding-bottom: 10px;
  border-bottom: 1px solid #edf0f3;
  text-align: right;
  font-size: 11px;
  line-height: 1.5;
  color: #8ea0b4;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
  border-top: none;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -4px 16px rgba(15, 23, 42, 0.05);
  backdrop-filter: blur(16px);
  display: flex;
  justify-content: center;
}

.save-btn {
  width: 100%;
  height: 46px;
  border-radius: 999px;
  background: linear-gradient(135deg, #76b6e1 0%, #4d89ba 52%, #3c73a2 100%);
  box-shadow: 0 12px 24px rgba(77, 137, 186, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
}

.save-btn-text {
  color: #ffffff;
  font-size: 15px;
  font-weight: 700;
}
