<view class="page">
  <view class="status-spacer"></view>

  <view class="nav-bar">
    <view class="nav-left" bindtap="onBack">
      <view class="nav-icon-wrap">
        <t-icon name="chevron-left" size="32rpx" />
      </view>
      <text class="nav-text">返回</text>
    </view>
    <text class="nav-title">营员信息</text>
    <view class="nav-right"></view>
  </view>

  <scroll-view class="scroll-area" scroll-y show-scrollbar="{{false}}">
    <view class="card form-card">
      <view class="field-row">
        <view class="field-label">孩子姓名</view>
        <view class="field-value">
          <t-input
            class="field-input"
            placeholder="姓名"
            borderless
            align="right"
            value="{{camper.name}}"
            bindchange="onNameChange"
          />
        </view>
      </view>
      <view class="field-row">
        <view class="field-label">孩子身份证明</view>
        <view class="field-value">
          <t-input
            class="field-input"
            placeholder="身份证/护照等有效证件"
            borderless
            align="right"
            value="{{camper.idNo}}"
            bindchange="onIdChange"
          />
        </view>
      </view>
      <view class="field-helper" wx:if="{{camper.idNoMask}}">
        <text>已保存证件信息，重新输入将覆盖原记录</text>
      </view>
      <view class="field-row">
        <view class="field-label">身高</view>
        <view class="field-value">
          <t-input
            class="field-input"
            placeholder="身高"
            borderless
            align="right"
            type="number"
            value="{{camper.height}}"
            bindchange="onHeightChange"
          />
        </view>
      </view>
      <view class="field-row">
        <view class="field-label">体重</view>
        <view class="field-value">
          <t-input
            class="field-input"
            placeholder="体重"
            borderless
            align="right"
            type="number"
            value="{{camper.weight}}"
            bindchange="onWeightChange"
          />
        </view>
      </view>
      <view class="field-row">
        <view class="field-label">忌口、过敏原</view>
        <view class="field-value">
          <t-input
            class="field-input"
            placeholder="忌口/过敏原"
            borderless
            align="right"
            value="{{camper.allergies}}"
            bindchange="onAllergiesChange"
          />
        </view>
      </view>
      <view class="field-row field-row--stacked field-row--last">
        <view class="field-label">一句话介绍孩子的性格</view>
        <view class="field-value">
          <t-input
            class="field-input field-input--stacked"
            placeholder="一句话描述孩子的性格特点"
            borderless
            align="left"
            value="{{camper.personality}}"
            bindchange="onPersonalityChange"
          />
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="bottom-bar">
    <view class="save-btn" bindtap="onSave">
      <text class="save-btn-text">确认</text>
    </view>
  </view>

</view>
