<view class="page">
  <view class="status-spacer"></view>

  <view class="nav-bar">
    <view class="nav-left" bindtap="onBack">
      <view class="nav-icon-wrap">
        <t-icon name="chevron-left" size="32rpx" />
      </view>
      <text class="nav-text">返回</text>
    </view>
    <text class="nav-title">我的信息填报</text>
    <view class="nav-right"></view>
  </view>

  <scroll-view class="scroll-area" scroll-y show-scrollbar="{{false}}">
    <view
      class="card submission-card {{item.status === 'submitted' ? 'submission-card--pending' : ''}}"
      wx:for="{{list}}"
      wx:key="id"
      data-activity-id="{{item.activityId}}"
      data-period-id="{{item.periodId}}"
      data-submission-id="{{item.id}}"
      data-status="{{item.status}}"
      bindtap="onOpen"
    >
      <view class="card-header">
        <view class="card-title-group">
          <text class="card-title">{{item.summary.title}}</text>
          <text class="card-sub">{{item.summary.sub}}</text>
        </view>
        <view class="status-tag {{item.status === 'paid' ? 'status-tag--paid' : 'status-tag--pending'}}">
          {{item.statusText}}
        </view>
      </view>
      <view class="card-divider"></view>
      <view class="card-footer">
        <text class="card-meta-inline">{{item.childrenCount}} 人报名 · {{item.updatedLabel || '--'}}</text>
        <view class="card-actions" catchtap>
          <view
            wx:if="{{item.status === 'paid'}}"
            class="detail-link"
            data-activity-id="{{item.activityId}}"
            data-period-id="{{item.periodId}}"
            data-submission-id="{{item.id}}"
            data-status="{{item.status}}"
            bindtap="onOpen"
          >
            <text class="detail-link-text">查看详情</text>
          </view>
          <block wx:else>
            <view
              class="action-btn action-btn--default"
              data-activity-id="{{item.activityId}}"
              data-period-id="{{item.periodId}}"
              data-submission-id="{{item.id}}"
              data-status="{{item.status}}"
              bindtap="onCancel"
            >
              <text>撤销</text>
            </view>
            <view
              class="action-btn action-btn--primary"
              data-activity-id="{{item.activityId}}"
              data-period-id="{{item.periodId}}"
              data-submission-id="{{item.id}}"
              data-status="{{item.status}}"
              bindtap="onOpen"
            >
              <text>继续支付</text>
            </view>
          </block>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{!list.length && !loading}}">
      <text>暂无填写记录</text>
    </view>
  </scroll-view>
</view>
