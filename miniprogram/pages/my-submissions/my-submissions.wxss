page {
  height: 100vh;
  background: #f2f5f8;
  color: #1f2a37;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
}

.status-spacer {
  height: 44px;
}

.nav-bar {
  padding: 6px 16px 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 14px;
  color: #64748b;
}

.nav-left,
.nav-right {
  display: flex;
  align-items: center;
  min-width: 60px;
}

.nav-left {
  color: #475569;
}

.nav-icon-wrap {
  width: 28px;
  height: 28px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f6f9;
  border: 1px solid rgba(148, 163, 184, 0.2);
  margin-right: 6px;
}

.nav-text {
  font-weight: 500;
}

.nav-title {
  font-size: 16px;
  font-weight: 600;
  color: #0f172a;
}

.nav-right {
  justify-content: flex-end;
}

.scroll-area {
  flex: 1;
  min-height: 0;
  padding: 16px;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 16px;
  border: 1px solid transparent;
  box-shadow: 0 6px 20px rgba(107, 135, 152, 0.05);
  margin-bottom: 16px;
}

.submission-card {
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.submission-card--pending {
  border-color: #f0e8d5;
}

.card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}

.card-title-group {
  flex: 1;
}

.card-title {
  font-size: 16px;
  font-weight: 600;
  color: #2c3e50;
  display: block;
  line-height: 1.5;
  letter-spacing: 0.02em;
}

.card-sub {
  font-size: 13px;
  color: #98a7b5;
  display: block;
  margin-top: 4px;
}

.status-tag {
  padding: 4px 8px;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 500;
  border: 1px solid transparent;
  flex-shrink: 0;
  margin-top: 2px;
}

.status-tag--paid {
  background: #f4f6f8;
  color: #a0aebc;
  border-color: transparent;
}

.status-tag--pending {
  background: #fcf9f2;
  color: #b08c5d;
  border-color: #f0e8d5;
}

.card-divider {
  height: 1px;
  background: #ebf0f4;
  margin: 6px 0 2px;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
}

.card-meta-inline {
  font-size: 12px;
  color: #98a7b5;
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.card-actions {
  display: flex;
  gap: 12px;
  align-items: center;
  flex-shrink: 0;
}

.action-btn {
  min-width: 72px;
  height: 30px;
  padding: 0 12px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: 500;
}

.action-btn--primary {
  background: linear-gradient(135deg, #7e9aa9 0%, #6b8798 100%);
  color: #ffffff;
  box-shadow: 0 4px 12px rgba(107, 135, 152, 0.3);
}

.action-btn--default {
  background: transparent;
  color: #6b8798;
  border: 1px solid #d1dbe0;
}

.detail-link {
  font-size: 13px;
  font-weight: 500;
  color: #6b8798;
  white-space: nowrap;
  display: flex;
  align-items: center;
}

.detail-link::after {
  content: '';
  display: inline-block;
  width: 6px;
  height: 6px;
  margin-left: 4px;
  border-top: 1.5px solid #8ba4b4;
  border-right: 1.5px solid #8ba4b4;
  transform: rotate(45deg);
}

.detail-link-text {
  color: #6b8798;
}

.empty {
  text-align: center;
  color: #94a3b8;
  font-size: 14px;
  margin-top: 40px;
}
