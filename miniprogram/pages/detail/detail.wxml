  <view class="period-mask" wx:if="{{periodPopupVisible}}" bindtap="onClosePeriods">
    <view class="period-sheet" catchtap>
      <view class="period-head">
        <view class="period-top">
          <text class="period-title">{{detailTitle}}</text>
          <text class="period-price">{{priceLabel}}</text>
        </view>
        <view class="period-sub">报名截止：{{periods[selectedPeriodIndex].deadline}}</view>
        <text class="period-quota">{{periods[selectedPeriodIndex].quota}}</text>
      </view>
      <view class="period-section-title">期数选择</view>
      <view class="period-list">
        <view
          class="period-item {{selectedPeriodIndex === index ? 'active' : ''}}"
          wx:for="{{periods}}"
          wx:key="id"
          data-index="{{index}}"
          bindtap="onSelectPeriod"
        >
          <text>{{item.name}}（{{item.date}}）</text>
        </view>
      </view>
      <t-button class="period-confirm" theme="primary" shape="round" size="small" bindtap="onConfirmPeriod">确认</t-button>
    </view>
  </view>

  <view class="teacher-mask" wx:if="{{teacherPopupVisible}}" bindtap="onCloseTeacherPopup">
    <view class="teacher-sheet" catchtap>
      <view class="teacher-head">
        <text class="teacher-title">咨询老师</text>
        <text class="teacher-sub">可添加微信或电话咨询</text>
      </view>
      <view class="teacher-list">
        <view class="teacher-item" wx:for="{{teacherContacts}}" wx:key="phone">
          <text class="teacher-line">{{item.name}}：{{item.phone}}</text>
        </view>
      </view>
      <view class="teacher-close-btn" bindtap="onCloseTeacherPopup">关闭</view>
    </view>
  </view>
</view>
