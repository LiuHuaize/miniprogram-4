<view class="page">
  <view class="status-spacer"></view>

  <view class="nav-bar">
    <view class="nav-left" bindtap="onBack">
      <view class="nav-icon-wrap">
        <t-icon name="chevron-left" size="32rpx" />
      </view>
      <text class="nav-text">返回</text>
    </view>
    <text class="nav-title">营会详情</text>
    <view class="nav-right"></view>
  </view>

  <scroll-view
    class="scroll-area"
    scroll-y
    show-scrollbar="{{false}}"
    scroll-top="{{scrollTop}}"
    scroll-with-animation="true"
  >
    <view class="hero-card">
      <view class="hero-image">
        <image
          class="hero-photo"
          mode="aspectFill"
          src="{{heroImageUrl || posterUrls[heroCoverPath] || heroCoverPath}}"
          data-src="{{heroImageUrl || posterUrls[heroCoverPath] || heroCoverPath}}"
          binderror="onImageError"
        />
        <view class="hero-mask" wx:if="{{isWinterCamp}}"></view>
        <view class="hero-badge" wx:if="{{isWinterCamp}}">2026 AI ENTREPRENEURSHIP CAMP</view>
        <view class="hero-title" wx:if="{{isWinterCamp}}">{{detailTitle}}</view>
        <view class="hero-sub" wx:if="{{isWinterCamp}}">{{periods[selectedPeriodIndex].location}} · {{durationLabel}}沉浸式项目制学习</view>
      </view>
    </view>

    <view class="info-card">
      <view class="info-main">
        <view class="info-left">
          <view class="info-topline">
            <text class="info-kicker">{{campSeriesLabel}}</text>
            <text class="info-status {{applyClosed ? 'is-closed' : 'is-open'}}">{{applyClosed ? '报名已结束' : '限额招生中'}}</text>
          </view>
          <text class="info-title">{{detailTitle}}</text>
          <text class="info-sub">营期时间：{{periods[selectedPeriodIndex].fullDate}}</text>
        </view>
        <view class="info-right">
          <view class="price-line">
            <text class="info-price-unit">{{priceUnit}}</text>
            <text class="info-price-value">{{priceValue}}</text>
          </view>
          <text class="info-price-note">{{priceNote}}</text>
        </view>
      </view>
      <view class="info-meta">
        <view class="meta-item">
          <view class="meta-icon-wrap">
            <t-icon name="time" size="24rpx" />
          </view>
          <text>{{durationLabel}}</text>
        </view>
        <view class="meta-item">
          <view class="meta-icon-wrap">
            <t-icon name="user" size="24rpx" />
          </view>
          <text>{{ageLabel}}</text>
        </view>
        <view class="meta-item">
          <view class="meta-icon-wrap">
            <t-icon name="location" size="24rpx" />
          </view>
          <text>{{periods[selectedPeriodIndex].location}}</text>
        </view>
      </view>
      <view class="period-row" bindtap="onOpenPeriods">
        <view class="period-left">
          <text class="period-label">期数</text>
          <text class="period-value">{{periods[selectedPeriodIndex].name}}（{{periods[selectedPeriodIndex].date}}）</text>
        </view>
        <view class="period-right">
          <text class="period-action">切换</text>
          <t-icon name="chevron-right" size="28rpx" />
        </view>
      </view>
    </view>

    <scroll-view class="tabs" scroll-x show-scrollbar="{{false}}">
      <view class="tab-list">
        <view
          class="tab-item {{activeTab === item.key ? 'active' : ''}}"
          wx:for="{{tabs}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onTab"
        >
          {{item.label}}
        </view>
      </view>
    </scroll-view>

    <view class="section-block" id="anchor-content-future" wx:if="{{isFutureCamp && activeTab === 'content'}}">
