page {
  height: 100vh;
  background: linear-gradient(180deg, #f9fbff 0%, #f2f6fb 52%, #edf2f7 100%);
  color: #1f2a37;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
}

.status-spacer {
  height: 44px;
}

.nav-bar {
  padding: 6px 16px 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 14px;
  color: #64748b;
}

.nav-left,
.nav-right {
  display: flex;
  align-items: center;
  min-width: 60px;
}

.nav-left {
  color: #475569;
}

.nav-icon-wrap {
  width: 28px;
  height: 28px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f6f9;
  border: 1px solid rgba(148, 163, 184, 0.2);
  margin-right: 6px;
}

.nav-text {
  font-weight: 500;
}

.nav-title {
  font-size: 16px;
  font-weight: 600;
  color: #0f172a;
}

.nav-right {
  justify-content: flex-end;
}

.scroll-area {
  flex: 1;
  min-height: 0;
  padding: 0 16px;
  padding-bottom: calc(108px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hero-card {
  position: relative;
  height: 250px;
  border-radius: 24px;
  overflow: hidden;
  background: #dbe4ea;
  box-shadow: 0 14px 30px rgba(15, 23, 42, 0.12);
}

.hero-cover {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.08), rgba(15, 23, 42, 0.52));
}

.hero-month,
.hero-status {
  position: absolute;
  top: 14px;
  padding: 8rpx 18rpx;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 600;
  backdrop-filter: blur(10px);
  z-index: 2;
}

.hero-month {
  left: 14px;
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
  border: 1px solid rgba(255, 255, 255, 0.22);
}

.hero-status {
  right: 14px;
}

.hero-status--active {
  background: rgba(255, 255, 255, 0.92);
  color: #0f172a;
}

.hero-status--soon {
  background: rgba(15, 23, 42, 0.25);
  color: #ffffff;
}

.hero-status--ended {
  background: rgba(255, 255, 255, 0.92);
  color: #64748b;
}


.info-card {
  margin: -18px 0 10px;
  padding: 18px 16px;
  border-radius: 22px;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 14px 28px rgba(15, 23, 42, 0.12);
  border: 1px solid rgba(255, 255, 255, 0.68);
  position: relative;
  z-index: 3;
}

.info-main {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 14px;
}

.info-left {
  flex: 1;
  min-width: 0;
}

.info-title {
  font-size: 16px;
  line-height: 1.45;
  font-weight: 700;
  color: #0f172a;
  display: block;
}

.info-sub {
  margin-top: 6px;
  font-size: 12px;
  line-height: 1.7;
  color: #64748b;
  display: block;
}

.info-right {
  flex-shrink: 0;
  text-align: right;
}

.info-deadline {
  font-size: 13px;
  font-weight: 700;
  color: #64748b;
  display: block;
}

.info-people {
  margin-top: 6px;
  font-size: 11px;
  color: #94a3b8;
  display: block;
}

.info-meta {
  margin-top: 14px;
  display: flex;
  gap: 8px;
}

.meta-chip {
  flex: 1;
  min-width: 0;
  border-radius: 999px;
  background: #f4f7fa;
  border: 1px solid rgba(148, 163, 184, 0.14);
  padding: 6px 10px;
  font-size: 11px;
  color: #7a8a9a;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
}

.tabs {
  margin-top: 8px;
}

.tab-list {
  display: flex;
  align-items: center;
  gap: 24px;
  padding: 0 8px;
}

.tab-item {
  padding: 12px 0;
  font-size: 14px;
  color: #94a3b8;
  white-space: nowrap;
  position: relative;
}

.tab-item.active {
  color: #7ca0b0;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 24px;
  height: 3px;
  border-radius: 2px;
  background: #7ca0b0;
}

.section-block {
  margin-top: 14px;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12px;
}

.section-head--sub {
  margin-top: 18px;
}

.section-left {
  display: flex;
  align-items: baseline;
  gap: 8px;
}

.section-title {
  font-size: 15px;
  font-weight: 700;
  color: #0f172a;
}

.section-en {
  font-size: 10px;
  letter-spacing: 0.2em;
  color: #b0bac5;
}

.section-brand {
  font-size: 10px;
  letter-spacing: 0.2em;
  color: #c2cbd4;
}

.section-card {
  background: rgba(255, 255, 255, 0.96);
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 12px 26px rgba(15, 23, 42, 0.1);
}

.intro-article-card {
  padding: 16px;
}

.article-image {
  width: 100%;
  display: block;
  border-radius: 12px;
  margin: 12px 0;
}

.intro-main {
  font-size: 14px;
  font-weight: 600;
  line-height: 1.7;
  color: #0f172a;
  display: block;
}

.intro-prompt {
  margin-top: 8px;
  font-size: 13px;
  line-height: 1.7;
  color: #64748b;
  display: block;
}

.point-list,
.question-list,
.rank-list,
.gallery-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.point-item {
  display: flex;
  gap: 10px;
  align-items: flex-start;
  background: rgba(255, 255, 255, 0.96);
  padding: 14px;
  border-radius: 18px;
  box-shadow: 0 10px 22px rgba(15, 23, 42, 0.08);
}

.point-index {
  width: 24px;
  height: 24px;
  border-radius: 999px;
  background: rgba(124, 160, 176, 0.12);
  color: #7ca0b0;
  font-size: 12px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.point-text {
  font-size: 13px;
  line-height: 1.7;
  color: #334155;
}

.question-card {
  background: rgba(255, 255, 255, 0.96);
  padding: 16px;
  border-radius: 18px;
  box-shadow: 0 10px 22px rgba(15, 23, 42, 0.08);
}

.question-label {
  font-size: 13px;
  font-weight: 700;
  color: #0f172a;
  display: block;
}

.question-answer {
  margin-top: 8px;
  font-size: 12px;
  line-height: 1.7;
  color: #64748b;
  display: block;
}

.rank-card {
  background: rgba(255, 255, 255, 0.96);
  border-radius: 20px;
  padding: 14px;
  display: flex;
  justify-content: space-between;
  gap: 12px;
  box-shadow: 0 12px 24px rgba(15, 23, 42, 0.08);
}

.rank-left {
  display: flex;
  gap: 10px;
  flex: 1;
  min-width: 0;
}

.rank-order {
  width: 26px;
  height: 26px;
  border-radius: 999px;
  background: #f1f5f9;
  color: #64748b;
  font-size: 12px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.rank-avatar,
.gallery-avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: linear-gradient(135deg, #c7dce6, #e7f1f5);
  color: #42616f;
  font-size: 16px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.rank-copy {
  flex: 1;
  min-width: 0;
}

.rank-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.rank-name {
  font-size: 14px;
  font-weight: 700;
  color: #0f172a;
}

.rank-tag,
.gallery-badge {
  padding: 6rpx 14rpx;
  border-radius: 999px;
  background: rgba(124, 160, 176, 0.12);
  color: #5c8091;
  font-size: 10px;
}


.rank-right {
  text-align: right;
  flex-shrink: 0;
}


.rank-status {
  margin-top: 6px;
  font-size: 11px;
  color: #94a3b8;
  display: block;
}

.gallery-tip {
  padding: 12px 14px;
  border-radius: 16px;
  background: rgba(124, 160, 176, 0.08);
  color: #64748b;
  font-size: 12px;
  line-height: 1.7;
  margin-bottom: 12px;
}

.gallery-card {
  background: rgba(255, 255, 255, 0.96);
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 12px 24px rgba(15, 23, 42, 0.08);
}

.gallery-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 14px 14px 0 14px;
}

.gallery-body {
  padding: 14px;
}

.gallery-inset-image {
  width: 100%;
  height: 160px;
  border-radius: 12px;
  display: block;
  margin-top: 12px;
}

.gallery-user {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
}

.gallery-user-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.gallery-name {
  font-size: 14px;
  font-weight: 700;
  color: #0f172a;
  display: block;
}

.gallery-site {
  margin-top: 4px;
  font-size: 11px;
  color: #94a3b8;
  display: block;
}

.gallery-title {
  margin-top: 12px;
  font-size: 15px;
  font-weight: 700;
  line-height: 1.45;
  color: #0f172a;
  display: block;
}

.gallery-summary {
  margin-top: 6px;
  font-size: 12px;
  line-height: 1.7;
  color: #64748b;
  display: block;
}

.qa-card {
  margin-top: 12px;
  padding: 12px 14px;
  border-radius: 14px;
  background: #f5f8fb;
  border: 1px solid rgba(148, 163, 184, 0.12);
}

.qa-item + .qa-item {
  margin-top: 10px;
}

.qa-q {
  font-size: 11px;
  font-weight: 600;
  color: #5c8091;
  display: block;
}

.qa-a {
  margin-top: 4px;
  font-size: 11px;
  color: #64748b;
  line-height: 1.6;
  display: block;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 10px 16px calc(12px + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(10px);
  box-shadow: 0 -10px 24px rgba(15, 23, 42, 0.08);
  z-index: 12;
}

.bottom-bar-inner {
  display: flex;
  align-items: center;
  gap: 12px;
}

.bottom-hint {
  width: 108px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  color: #64748b;
}

.bottom-hint-text {
  font-size: 10px;
  text-align: center;
  line-height: 1.4;
}

.bottom-btn-wrap {
  flex: 1;
}

.submit-btn {
  --td-button-primary-bg-color: #7ca0b0;
  --td-button-primary-border-color: #7ca0b0;
  --td-button-primary-hover-bg-color: #6e93a4;
  --td-button-primary-hover-border-color: #6e93a4;
  height: 44px;
  font-size: 15px;
  font-weight: 600;
}

.submit-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.42);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 30;
}

.submit-sheet {
  width: 100%;
  background: #ffffff;
  border-top-left-radius: 22px;
  border-top-right-radius: 22px;
  padding: 18px 16px calc(18px + env(safe-area-inset-bottom));
  box-shadow: 0 -14px 28px rgba(15, 23, 42, 0.18);
}

.submit-head {
  padding-bottom: 12px;
  border-bottom: 1px solid #edf1f5;
}

.submit-title {
  font-size: 16px;
  font-weight: 700;
  color: #0f172a;
  display: block;
}


.submit-scroll {
  max-height: 56vh;
  margin-top: 12px;
}

.form-section + .form-section {
  margin-top: 14px;
}

.form-title {
  font-size: 13px;
  font-weight: 700;
  color: #0f172a;
  display: block;
}

.upload-grid {
  margin-top: 10px;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.upload-item {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16px;
  overflow: hidden;
  position: relative;
}

.upload-add {
  background: #f8fafc;
  border: 1px dashed rgba(148, 163, 184, 0.5);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
}

.upload-add-text {
  font-size: 11px;
  color: #94a3b8;
}

.upload-preview {
  background: #e2e8f0;
}

.upload-image {
  width: 100%;
  height: 100%;
  display: block;
}

.upload-remove {
  position: absolute;
  top: 6px;
  right: 6px;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: rgba(15, 23, 42, 0.65);
  color: #ffffff;
  font-size: 15px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.form-textarea {
  width: 100%;
  min-height: 110px;
  margin-top: 10px;
  padding: 12px 14px;
  border-radius: 16px;
  background: #f8fafc;
  border: 1px solid rgba(148, 163, 184, 0.18);
  box-sizing: border-box;
  font-size: 13px;
  color: #0f172a;
  line-height: 1.7;
}

.form-textarea--small {
  min-height: 80px;
}

.submit-actions {
  margin-top: 16px;
  display: flex;
  gap: 10px;
}

.submit-cancel,
.submit-confirm {
  flex: 1;
  height: 42px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: 600;
}

.submit-cancel {
  background: #f1f5f9;
  color: #64748b;
}

.submit-confirm {
  background: #7ca0b0;
  color: #ffffff;
}
