page {
  height: 100vh;
  background: linear-gradient(180deg, #ffffff 0%, #f6f8fb 100%);
  color: #1f2937;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.status-spacer {
  height: 44px;
}

.nav-bar {
  padding: 6px 16px 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #64748b;
}

.nav-left,
.nav-right {
  display: flex;
  align-items: center;
  min-width: 60px;
}

.nav-icon-wrap {
  width: 28px;
  height: 28px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f6f9;
  border: 1px solid rgba(148, 163, 184, 0.2);
  margin-right: 6px;
}

.nav-text {
  font-size: 14px;
  font-weight: 500;
  color: #475569;
}

.nav-title {
  font-size: 16px;
  font-weight: 600;
  color: #0f172a;
}

.nav-right {
  justify-content: flex-end;
}

.content {
  flex: 1;
  padding: 36px 24px calc(40px + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
}

.result-icon {
  width: 72px;
  height: 72px;
  border-radius: 999px;
  background: rgba(47, 125, 117, 0.12);
  color: #2f7d75;
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-title {
  margin-top: 18px;
  font-size: 22px;
  font-weight: 600;
  color: #0f172a;
}

.result-desc {
  margin-top: 10px;
  font-size: 15px;
  color: #475569;
  line-height: 1.7;
}

.countdown-text {
  margin-top: 12px;
  font-size: 13px;
  color: #94a3b8;
}

.home-btn {
  width: 100%;
  margin-top: 28px;
  --td-button-primary-bg-color: #2f7d75;
  --td-button-primary-border-color: #2f7d75;
  --td-button-primary-hover-bg-color: #24665f;
  --td-button-primary-hover-border-color: #24665f;
}
