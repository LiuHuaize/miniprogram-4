page {
  height: 100vh;
  background: linear-gradient(180deg, #f8fafc 0%, #eef3f8 100%);
  color: #1f2a37;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.page {
  height: 100vh;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

.status-spacer {
  height: 44px;
}

.nav-bar {
  padding: 6px 16px 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 14px;
  color: #64748b;
}

.nav-left,
.nav-right {
  display: flex;
  align-items: center;
  min-width: 60px;
}

.nav-left {
  color: #475569;
}

.nav-icon-wrap {
  width: 28px;
  height: 28px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f6f9;
  border: 1px solid rgba(148, 163, 184, 0.2);
  margin-right: 6px;
}

.nav-text {
  font-weight: 500;
}

.nav-title {
  font-size: 16px;
  font-weight: 600;
  color: #0f172a;
}

.nav-right {
  justify-content: flex-end;
}

.nav-action {
  width: 30px;
  height: 30px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f6f9;
  border: 1px solid rgba(148, 163, 184, 0.2);
  color: #64748b;
}

.scroll-area {
  flex: 1;
  min-height: 0;
  padding: 0 16px;
  box-sizing: border-box;
}

.scroll-bottom-spacer {
  height: calc(168px + env(safe-area-inset-bottom));
}

.card {
  background: linear-gradient(180deg, #ffffff 0%, #f9fbff 100%);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 16px;
  box-shadow: 0 10px 22px rgba(15, 23, 42, 0.08);
  margin-bottom: 12px;
}

.summary-card {
  display: flex;
  gap: 12px;
  padding: 14px;
  align-items: flex-start;
}

.summary-thumb {
  width: 84px;
  height: 64px;
  border-radius: 12px;
  background: #dbeafe;
}

.summary-main {
  flex: 1;
  min-width: 0;
}

.summary-title {
  font-size: 14px;
  font-weight: 600;
  color: #0f172a;
  display: block;
  line-height: 1.4;
}

.summary-sub {
  margin-top: 4px;
  font-size: 11px;
  color: #94a3b8;
  display: block;
}

.summary-price {
  font-size: 15px;
  font-weight: 700;
  color: #64748b;
  white-space: nowrap;
}

.summary-price-wrap,
.period-price-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4px;
}

.summary-price-wrap {
  flex-shrink: 0;
  max-width: 140px;
}

.summary-price-wrap .summary-price,
.summary-price-wrap .price-detail {
  width: 100%;
  text-align: right;
}

.summary-price-wrap .price-detail {
  white-space: normal;
  color: #7b8a99;
}

.period-price-wrap {
  max-width: 150px;
}

.period-price-wrap .price-detail {
  text-align: right;
  white-space: normal;
}

.price-detail {
  font-size: 10px;
  line-height: 1.3;
  color: #64748b;
}

.discount-tag {
  font-size: 10px;
  line-height: 1.3;
  color: #4c7385;
  padding: 3px 8px;
  border-radius: 999px;
  border: 1px solid rgba(124, 160, 176, 0.45);
  background: rgba(124, 160, 176, 0.16);
  text-align: center;
}

.period-card {
  padding: 12px 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.period-left {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.period-label {
  font-size: 11px;
  color: #a0aec0;
}

.period-value {
  font-size: 12px;
  color: #0f172a;
  display: block;
}

.section {
  margin-top: 10px;
}

.section-title {
  font-size: 13px;
  font-weight: 600;
  color: #0f172a;
  margin-bottom: 8px;
}

.count-card {
  padding: 12px 14px;
}

.count-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.count-label {
  font-size: 13px;
  color: #0f172a;
}

.count-stepper {
  display: flex;
  align-items: center;
  gap: 10px;
}

.step-btn {
  width: 28px;
  height: 28px;
  border-radius: 8px;
  background: #eef3f7;
  color: #7ca0b0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  font-weight: 600;
}

.step-btn.disabled {
  color: #cbd5e1;
  background: #f5f7fa;
}

.step-value {
  font-size: 14px;
  font-weight: 600;
  color: #0f172a;
  width: 18px;
  text-align: center;
}

.camper-card {
  padding: 12px 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.camper-left {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.camper-title {
  font-size: 12px;
  color: #94a3b8;
  display: block;
}

.camper-sub {
  font-size: 13px;
  color: #0f172a;
  display: block;
}

.form-card {
  padding: 0 12px;
}

.scholarship-card {
  padding-bottom: 12px;
}

.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 4px;
  font-size: 13px;
  border-bottom: 1px solid #edf0f3;
  gap: 12px;
}

.field-row--last {
  border-bottom: none;
}

.field-row--stack {
  align-items: flex-start;
}

.field-label {
  color: #1f2937;
  font-weight: 500;
  min-width: 88px;
  line-height: 1.4;
}

.field-label--multi {
  padding-top: 8px;
}

.field-value {
  flex: 1;
  min-width: 0;
  display: flex;
  justify-content: flex-start;
}

.field-value--with-action {
  align-items: center;
  gap: 12px;
}

.field-input {
  width: 100%;
  text-align: left;
  --td-input-vertical-padding: 6px;
  --td-input-bg-color: transparent;
  --td-input-placeholder-text-color: #94a3b8;
  --td-input-default-text-color: #1f2937;
}

.code-action {
  flex: 0 0 auto;
  min-width: 64px;
  height: 30px;
  border-radius: 999px;
  background: rgba(124, 160, 176, 0.14);
  color: #4c7385;
  border: 1px solid rgba(124, 160, 176, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 600;
}

.scholarship-helper {
  margin: 10px 4px 0;
  padding: 10px 12px;
  border-radius: 12px;
  border: 1px solid rgba(148, 163, 184, 0.18);
  background: #f8fafc;
  color: #64748b;
  font-size: 11px;
  line-height: 1.6;
}

.scholarship-helper--success {
  color: #2f7d75;
  background: rgba(47, 125, 117, 0.08);
  border-color: rgba(47, 125, 117, 0.2);
}

.scholarship-helper--warning {
  color: #b45309;
  background: rgba(245, 158, 11, 0.08);
  border-color: rgba(245, 158, 11, 0.2);
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
  border-top: none;
  background: #ffffff;
  box-shadow: 0 -12px 26px rgba(15, 23, 42, 0.08);
  z-index: 10;
}

.bottom-left {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
  flex: 1;
}

.bottom-label {
  font-size: 11px;
  color: #a0aec0;
  display: block;
}

.bottom-price {
  margin-top: 2px;
  font-size: 18px;
  font-weight: 700;
  color: #0f172a;
  display: block;
}

.discount-note {
  margin-top: 2px;
  font-size: 10px;
  color: #4c7385;
  line-height: 1.3;
  display: block;
}

.submit-btn {
  --td-button-primary-bg-color: #7ca0b0;
  --td-button-primary-border-color: #7ca0b0;
  --td-button-primary-hover-bg-color: #688e9f;
  --td-button-primary-hover-border-color: #688e9f;
  min-width: 168px;
  height: 50px;
  padding: 0 32px;
  font-size: 16px;
  font-weight: 700;
  border-radius: 999px;
  box-shadow: 0 10px 18px rgba(124, 160, 176, 0.24);
}

.period-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.4);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 20;
}

.period-sheet {
  width: 100%;
  background: #ffffff;
  border-top-left-radius: 18px;
  border-top-right-radius: 18px;
  padding: 18px 16px calc(24px + env(safe-area-inset-bottom));
  box-shadow: 0 -14px 28px rgba(15, 23, 42, 0.18);
}

.period-head {
  padding-bottom: 12px;
  border-bottom: 1px solid #edf1f5;
}

.period-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
}

.period-title {
  font-size: 14px;
  font-weight: 600;
  color: #0f172a;
  line-height: 1.4;
  display: block;
}

.period-price {
  font-size: 16px;
  font-weight: 700;
  color: #64748b;
  white-space: nowrap;
  display: block;
}

.period-sub {
  margin-top: 6px;
  font-size: 11px;
  color: #94a3b8;
  display: block;
}

.period-quota {
  margin-top: 4px;
  font-size: 12px;
  color: #7b8a99;
  display: block;
}

.period-section-title {
  margin-top: 14px;
  font-size: 13px;
  font-weight: 600;
  color: #0f172a;
}

.period-list {
  margin-top: 10px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.period-item {
  padding: 12px 14px;
  border-radius: 12px;
  background: #f8fafc;
  border: 1px solid rgba(148, 163, 184, 0.2);
  font-size: 12px;
  color: #64748b;
}

.period-item.active {
  background: rgba(124, 160, 176, 0.08);
  border-color: rgba(124, 160, 176, 0.4);
  color: #7ca0b0;
  font-weight: 600;
}

.period-confirm {
  --td-button-primary-bg-color: #7ca0b0;
  --td-button-primary-border-color: #7ca0b0;
  --td-button-primary-hover-bg-color: #688e9f;
  --td-button-primary-hover-border-color: #688e9f;
  margin-top: 16px;
  width: 100%;
  height: 40px;
  font-size: 13px;
  font-weight: 600;
}

