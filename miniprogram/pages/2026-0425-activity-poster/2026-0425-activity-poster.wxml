<view class="page">
  <view class="status-spacer"></view>

  <view class="nav-bar">
    <view class="nav-left" bindtap="onBack">
      <view class="nav-icon-wrap">
        <t-icon name="chevron-left" size="32rpx" />
      </view>
      <text class="nav-text">返回</text>
    </view>
    <text class="nav-title">4.25活动海报</text>
    <view class="nav-right"></view>
  </view>

  <scroll-view class="scroll-area" scroll-y show-scrollbar="{{false}}">
    <view class="card intro-card">
      <text class="intro-eyebrow">4.25 线下主题活动</text>
      <view class="intro-title-group">
        <text class="intro-title">AI时代</text>
        <text class="intro-title intro-title-sub">少年创业力峰会</text>
      </view>
      <text class="intro-desc">聚焦 AI 时代青少年创新思维、产品意识与创业力培养。请家长先填写报名信息，用于席位确认与活动通知。</text>
      <view class="intro-tags">
        <text class="intro-tag">4月25日 13:30 - 17:30</text>
        <text class="intro-tag">线下峰会</text>
        <text class="intro-tag">席位确认</text>
      </view>
    </view>

    <view class="section">
      <view class="section-title">活动海报</view>
      <view class="card poster-card">
        <image
          class="poster-image"
          src="{{posterSrc}}"
          mode="widthFix"
          lazy-load="true"
          binderror="onPosterError"
        />
      </view>
    </view>

    <view class="section">
      <view class="section-title">报名信息</view>
      <view class="card form-card">
        <view class="field-row">
          <view class="field-label">家长真实姓名</view>
          <view class="field-value">
            <t-input
              class="field-input"
              placeholder="姓名"
              borderless
              align="right"
              value="{{form.parentName}}"
              bindchange="onParentNameChange"
            />
          </view>
        </view>
        <view class="field-row">
          <view class="field-label">联系电话</view>
          <view class="field-value">
            <t-input
              class="field-input"
              placeholder="手机号码"
              borderless
              align="right"
              type="number"
              value="{{form.phone}}"
              bindchange="onPhoneChange"
            />
          </view>
        </view>
        <view class="field-row field-row--last">
          <view class="field-label">孩子年龄</view>
          <view class="field-value">
            <t-input
              class="field-input"
              placeholder="年龄（岁）"
              borderless
              align="right"
              type="number"
              value="{{form.childAge}}"
              bindchange="onChildAgeChange"
            />
          </view>
        </view>
      </view>
      <text class="form-note">报名信息将用于席位确认与活动通知。</text>
    </view>

    <view class="scroll-bottom-spacer"></view>
  </scroll-view>

  <view class="bottom-bar">
    <view class="bottom-left">
      <text class="bottom-label">应付金额</text>
      <view class="bottom-price">
        <text class="price-currency">¥</text>
        <text class="price-number">299</text>
      </view>
      <text class="bottom-note">填写完成后再发起支付</text>
    </view>
    <t-button
      class="submit-btn"
      theme="primary"
      shape="round"
      size="large"
      disabled="{{paying}}"
      bindtap="onPay"
    >
      {{paying ? '处理中...' : '立即支付'}}
    </t-button>
  </view>
</view>
