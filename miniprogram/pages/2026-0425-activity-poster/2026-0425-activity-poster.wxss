page {
  height: 100vh;
  background: #f4f7fa;
  color: #34495e;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.page {
  height: 100vh;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

.status-spacer {
  height: 44px;
}

.nav-bar {
  padding: 8px 16px 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 14px;
  color: #64748b;
}

.nav-left,
.nav-right {
  display: flex;
  align-items: center;
  min-width: 60px;
}

.nav-left {
  color: #475569;
}

.nav-icon-wrap {
  width: 30px;
  height: 30px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.14);
  box-shadow: 0 3px 10px rgba(148, 163, 184, 0.08);
  margin-right: 8px;
}

.nav-text {
  font-size: 16px;
  font-weight: 500;
}

.nav-title {
  font-size: 17px;
  font-weight: 600;
  color: #2c3e50;
}

.nav-right {
  justify-content: flex-end;
}

.scroll-area {
  flex: 1;
  min-height: 0;
  padding: 12px 16px 0;
  box-sizing: border-box;
}

.scroll-bottom-spacer {
  height: calc(136px + env(safe-area-inset-bottom));
}

.card {
  background: #ffffff;
  border: none;
  border-radius: 16px;
  box-shadow: 0 8px 24px rgba(44, 62, 80, 0.04);
}

.intro-card {
  padding: 24px 20px;
}

.intro-eyebrow {
  display: inline-flex;
  align-items: center;
  padding: 4px 10px;
  border-radius: 4px;
  background: rgba(108, 141, 159, 0.1);
  color: #6c8d9f;
  font-size: 12px;
  font-weight: 600;
}

.intro-title-group {
  margin-top: 14px;
}

.intro-title {
  display: block;
  font-size: 23px;
  line-height: 1.4;
  font-weight: 600;
  color: #2c3e50;
  letter-spacing: 0.5px;
}

.intro-title-sub {
  margin-top: 2px;
}

.intro-desc {
  display: block;
  margin-top: 12px;
  font-size: 13px;
  line-height: 1.7;
  color: #8a9cae;
}

.intro-tags {
  margin-top: 18px;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.intro-tag {
  padding: 5px 14px;
  border-radius: 999px;
  background: #f4f7fa;
  color: #8a9cae;
  font-size: 12px;
}

.section {
  margin-top: 20px;
}

.section-title {
  font-size: 16px;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 12px;
  padding-left: 4px;
}

.poster-card {
  padding: 10px;
}

.poster-image {
  width: 100%;
  display: block;
  border-radius: 12px;
  background: #e2e8f0;
}

.form-card {
  padding: 2px 14px;
}

.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 2px;
  font-size: 13px;
  border-bottom: 1px solid #edf0f3;
  gap: 16px;
}

.field-row--last {
  border-bottom: none;
}

.field-label {
  color: #1f2937;
  font-weight: 600;
  flex: 0 0 132px;
  width: 132px;
  line-height: 1.4;
}

.field-value {
  flex: 1;
  min-width: 0;
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

.field-input {
  width: 100%;
  text-align: right;
  --td-input-vertical-padding: 4px;
  --td-input-horizontal-padding: 0;
  --td-input-bg-color: transparent;
  --td-input-placeholder-text-color: #a0aec0;
  --td-input-default-text-color: #1f2937;
}

.form-note {
  display: block;
  margin-top: 10px;
  padding: 0 4px;
  font-size: 12px;
  line-height: 1.6;
  color: #8a9cae;
}

.bottom-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 20px calc(12px + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.03);
  z-index: 10;
}

.bottom-left {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
}

.bottom-label {
  font-size: 12px;
  color: #8a9cae;
  display: block;
  margin-bottom: -2px;
}

.bottom-price {
  margin-top: 4px;
  display: flex;
  align-items: baseline;
  color: #2c3e50;
}

.price-currency {
  font-size: 16px;
  font-weight: 700;
  line-height: 1;
}

.price-number {
  margin-left: 2px;
  font-size: 26px;
  font-weight: 700;
  line-height: 1;
}

.bottom-note {
  margin-top: 2px;
  font-size: 11px;
  line-height: 1.3;
  color: #8a9cae;
  display: block;
}

.submit-btn {
  --td-button-primary-bg-color: #6c8d9f;
  --td-button-primary-border-color: #6c8d9f;
  --td-button-primary-hover-bg-color: #5e7e8f;
  min-width: 240rpx;
  font-weight: 600;
}
